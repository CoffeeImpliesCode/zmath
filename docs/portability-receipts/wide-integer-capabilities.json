  "source": "#include <stdint.h>\n#if defined(__BITINT_MAXWIDTH__) && __BITINT_MAXWIDTH__ >= 128\ntypedef _BitInt(128) i128;\ntypedef unsigned _BitInt(128) u128;\n#elif defined(__SIZEOF_INT128__)\ntypedef __int128 i128;\ntypedef unsigned __int128 u128;\n#else\n#error \"No signed and unsigned 128-bit integer type\"\n#endif\n_Static_assert(sizeof(i128) == 16 && sizeof(u128) == 16, \"128-bit storage\");\nu128 wide_multiply(u128 a, u128 b) { return a * b; }\nu128 wide_divide(u128 a, u128 b) { return a / b; }\nu128 wide_shift(u128 a, unsigned s) { return a >> (s & 127); }\ni128 signed_shift(i128 a, unsigned s) { return a >> (s & 127); }\nuint64_t wide_low_word(u128 a) { return (uint64_t)a; }\nuint64_t wide_high_word(u128 a) { return (uint64_t)(a >> 64); }\n",
