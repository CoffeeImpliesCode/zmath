export DIRENV_WARN_TIMEOUT=20s

# Nix is not installed natively on this host: ~/.local/bin/nix and
# ~/.local/bin/devenv run it inside an apptainer sandbox, so /nix/store does
# not exist here and every store path a devshell exports is unreachable.
#
# direnv evaluates this file with the ambient PATH, so the user toolchain
# (devenv, zig, zig-gate) has to be on it before `use devenv` can start.
export PATH="$HOME/.local/bin:$PATH"

eval "$(devenv direnvrc)"

# `use devenv` supports the same options as the `devenv shell` command.
#
# To silence the output, use `--quiet`.
#
# Example usage: use devenv --quiet --impure --option services.postgres.enable:bool true
use devenv

# devenv scripts are store derivations, so scripts.gate.exec materialises as
# /nix/store/...-gate/bin/gate and `direnv exec . gate` finds nothing on a host
# without a store. Emit the same contract into a gitignored directory instead.
gate_bin="$PWD/.devenv/host-bin"
mkdir -p "$gate_bin"
printf '#!/bin/sh\nexec zig-gate "$@"\n' > "$gate_bin/gate.tmp"
chmod +x "$gate_bin/gate.tmp"
mv -f "$gate_bin/gate.tmp" "$gate_bin/gate"
export PATH="$gate_bin:$PATH"
